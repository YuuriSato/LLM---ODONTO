# Production: exact model, no automatic fallback.
APP_ENV=production
WEB_PORT=9090
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
AI_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=8192

# Experimental tools only, enabled by APP_ENV=development.
OLLAMA_HOST=http://127.0.0.1:11435
VISION_MODEL=codex-dental:latest
HISTORY_PAGE_SIZE=8
